# Resend API key for sending website enquiry emails. Keep this secret.
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Must be a sender address/domain verified in Resend before production use.
# Example after verifying intelleducare.com: IntellEducare Website <website@intelleducare.com>
CONTACT_FROM_EMAIL=IntellEducare Website <website@intelleducare.com>

# Website enquiries are delivered to this inbox by default.
CONTACT_TO_EMAIL=Info@intelleducare.com
